hermes_home/*
# Keep these files
!hermes_home/config.yaml
!hermes_home/SOUL.md

# Keep these directories
# (hermes_home/cron/ is deliberately NOT kept — it's runtime state: a
# sqlite job-execution db, lock files, heartbeats, and per-run output dumps
# that mutate every cron tick, not source-controlled config. Same category
# as hermes_home/logs/, which is already covered by the blanket ignore
# above and never whitelisted here.)
!hermes_home/memories/
!hermes_home/profiles/
!hermes_home/hooks/
!hermes_home/skills/

# Ignore everything inside them by default
hermes_home/memories/*
hermes_home/profiles/*
hermes_home/hooks/*
hermes_home/skills/*

# Re-include everything in these directories
!hermes_home/memories/**
!hermes_home/profiles/**
!hermes_home/hooks/**

# Lock files written by the memory store at runtime — not source content
hermes_home/memories/*.lock

# For skills, only include custom skills
# (Assuming bundled skills are in a known subdirectory)
!hermes_home/skills/custom/**
skills/default/**

__pycache__/
*.pyc

.env
secrets/
.claude

# direnv
.direnv/

# terraform (state can contain secrets/resource data — never commit it,
# regardless of which directory it ends up in)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

.vscode
