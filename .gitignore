hermes_home/*
# Keep these files
!hermes_home/config.yaml
!hermes_home/SOUL.md

# Keep these directories
!hermes_home/memories/
!hermes_home/profiles/
!hermes_home/hooks/
!hermes_home/cron/
!hermes_home/skills/

# Ignore everything inside them by default
hermes_home/memories/*
hermes_home/profiles/*
hermes_home/hooks/*
hermes_home/cron/*
hermes_home/skills/*

# Re-include everything in these directories
!hermes_home/memories/**
!hermes_home/profiles/**
!hermes_home/hooks/**
!hermes_home/cron/**

# For skills, only include custom skills
# (Assuming bundled skills are in a known subdirectory)
!hermes_home/skills/custom/**
skills/default/**

__pycache__/
*.pyc

.env
secrets/
.claude

# direnv
.direnv/

# terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
